{
  "name": "codex-web",
  "version": "0.1.0",
  "files": [
    "README.md",
    "scratch/asar/**/*",
    "src/server/**/*.js",
    "src/shared/**/*.js",
    "src/server/electron/index.js",
    "!**/*.ts"
  ],
  "bin": "src/server/main.js",
  "scripts": {
    "build": "npm run prepare:asar && npm run build:browser && npm run build:server && npm run build:pwa && npm run build:lite",
    "launch:unpacked:server": "http-server ./scratch/asar/webview -a localhost -p 5175 -c-1",
    "launch:unpacked": "NODE_ENV=development electron ./scratch/asar --remote-debugging-port=9222",
    "dev:browser": "vite --config vite.browser.config.ts",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:server": "cd src/server && tsc",
    "build:lite": "node scripts/build-lite.mjs",
    "prepare:asar": "node scripts/prepare-desktop.mjs",
    "server": "node src/server/main.js",
    "setup": "node scripts/prepare-desktop.mjs",
    "audit:privacy": "node scripts/privacy-audit.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "node scripts/run-tests.mjs",
    "test:desktop": "node scripts/run-tests.mjs --desktop",
    "build:pwa": "node ops/build-mobile-pwa.mjs"
  },
  "repository": "https://github.com/Misoryan/codex-web.git",
  "author": "martin <martincharles07@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.1",
    "@noble/hashes": "2.0.1",
    "@tanstack/react-query": "^5.100.9",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.9.0",
    "fastify": "^5.8.5",
    "glob": "^13.0.6",
    "playwright-core": "^1.63.0",
    "prettier": "^3.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "safe-stable-stringify": "2.5.0",
    "sharp-cli": "^5.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "ws": "^8.20.0",
    "sharp": "^0.34.2",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "41.2.0",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Self-hosted Codex Desktop browser bridge with Full/Lite, mobile PWA and resumable sessions"
}
